programa {

  inteiro num1, num2, soma
  funcao inicio() {
    escreva("-------------------------------------\n")
    escreva("            S O M A D O R            \n")
    escreva("-------------------------------------\n")
    escreva("Digite o primeiro numero: \n")
    leia(num1)
    escreva("Digite o segundo numero: \n")
    leia(num2)
    soma = (num1 + num2)
    escreva("A soma dos numeros e: ", soma)
  }
}
